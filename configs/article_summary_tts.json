{
  "schema_version": 1,
  "default_provider": "edge_tts",
  "fallback_provider": null,
  "providers": {
    "edge_tts": {
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": "+5%",
      "volume": "+0%",
      "pitch": "+0Hz",
      "minimum_version": "7.3.1",
      "request_timeout_seconds": 120,
      "conversion_timeout_seconds": 90
    },
    "melo_onnx": {
      "num_threads": 2
    }
  },
  "audio_output": {
    "sample_rate": 44100,
    "channels": 1,
    "sample_width_bytes": 2,
    "subtype": "PCM_16"
  },
  "policy": {
    "automatic_provider_fallback": false,
    "network_retries": 0,
    "timeline_authority": "measured_pcm_wav_sample_counts"
  },
  "duration_policy": {
    "target_programme_seconds": 60,
    "minimum_programme_seconds": 58,
    "maximum_programme_seconds": 62,
    "target_cjk_characters": {
      "minimum": 222,
      "maximum": 235
    },
    "rate_adjustment": {
      "default_percent": 5,
      "maximum_percent": 8,
      "automatic_adaptation": false,
      "reference_rate_percent": 5
    },
    "measured_pcm_duration_is_release_authority": true,
    "expected_cjk_characters_per_second_at_reference_rate": 4.2
  }
}
